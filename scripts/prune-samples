#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'USAGE'
Usage:
  ./scripts/prune-samples

Prunes aggregate activity history in the running web container using its
PLEX_ACTIVITY_RETENTION_DAYS setting (default 90). Legacy details are preserved.
USAGE
  exit 0
fi

docker compose exec -T web ./bin/rails plex:prune_now_playing_samples
