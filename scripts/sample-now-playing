#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'USAGE'
Usage:
  ./scripts/sample-now-playing

Records aggregate activity for the current minute in the running web container.
USAGE
  exit 0
fi

docker compose exec -T web ./bin/rails plex:sample_now_playing
