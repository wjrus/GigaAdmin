#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

log() {
  printf "\n==> %s\n" "$*"
}

fail() {
  printf "\nDeploy failed: %s\n" "$*" >&2
  exit 1
}

require_file() {
  [[ -f "$1" ]] || fail "missing $1. Copy the matching .example file and fill it in."
}

compose() {
  docker compose "$@"
}

require_clean_tracked_worktree() {
  git diff --quiet || fail "tracked files have unstaged changes. Commit, stash, or inspect them before deploying."
  git diff --cached --quiet || fail "tracked files have staged changes. Commit, stash, or inspect them before deploying."
}

update_code() {
  if [[ ! -e .git ]]; then
    log "Skipping git pull; Git checkout not present"
    return
  fi

  require_clean_tracked_worktree

  log "Pulling latest code"
  git pull --ff-only
}

set_app_revision() {
  if [[ -e .git ]]; then
    APP_REVISION="$(git rev-parse --short HEAD)"
  else
    APP_REVISION="${APP_REVISION:-unknown}"
  fi

  export APP_REVISION
  log "Using app revision ${APP_REVISION}"
}

container_state() {
  local service="$1"
  local container_id

  container_id="$(compose ps -q "$service")"
  [[ -n "$container_id" ]] || {
    printf "missing"
    return
  }

  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container_id"
}

wait_for_healthy() {
  local service="$1"
  local timeout_seconds="$2"
  local elapsed=0
  local state

  while (( elapsed < timeout_seconds )); do
    state="$(container_state "$service")"

    if [[ "$state" == "healthy" ]]; then
      printf "%s is healthy\n" "$service"
      return 0
    fi

    if [[ "$state" == "exited" || "$state" == "dead" || "$state" == "unhealthy" ]]; then
      compose logs --tail=120 "$service" >&2 || true
      fail "$service is $state"
    fi

    sleep 3
    elapsed=$((elapsed + 3))
  done

  compose logs --tail=120 "$service" >&2 || true
  fail "$service did not become healthy within ${timeout_seconds}s"
}

wait_for_http() {
  local timeout_seconds="$1"
  local deadline=$((SECONDS + timeout_seconds))
  local app_host
  local ssl_mode
  local container_port=80
  local published_endpoint
  local bind_address
  local port
  local health_url
  local response_code
  local curl_options=(--connect-timeout 2 --max-time 3 --noproxy '*' --globoff -fsS --head --output /dev/null --write-out '%{http_code}')

  # Read only public routing settings, never the complete container environment.
  app_host="$(compose exec -T web printenv PLEX_HOST)" || app_host=""
  app_host="${app_host:-plexadmin.example.com}"
  [[ "$app_host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] ||
    fail "PLEX_HOST must be a hostname without a scheme, port, or path"
  ssl_mode="$(compose exec -T web printenv GIGAADMIN_SSL_MODE)" || ssl_mode=""
  ssl_mode="${ssl_mode:-proxy}"
  case "$ssl_mode" in
    local|proxy) ;;
    letsencrypt) container_port=443 ;;
    *) fail "GIGAADMIN_SSL_MODE must be local, proxy, or letsencrypt" ;;
  esac
  published_endpoint="$(compose port web "$container_port")" || fail "could not determine the published web port"
  # Compose may report both IPv4 and IPv6 mappings. Probe its first mapping.
  published_endpoint="${published_endpoint%%$'\n'*}"
  bind_address="${published_endpoint%:*}"
  port="${published_endpoint##*:}"
  bind_address="${bind_address#\[}"
  bind_address="${bind_address%\]}"

  [[ "$published_endpoint" == *:* && "$bind_address" =~ ^[0-9a-fA-F:.]+$ && "$port" =~ ^[0-9]{1,5}$ ]] &&
    (( 10#$port >= 1 && 10#$port <= 65535 )) ||
    fail "web has no usable published TCP port"

  case "$bind_address" in
    0.0.0.0) bind_address="127.0.0.1" ;;
    ::) bind_address="::1" ;;
  esac
  [[ "$bind_address" != *:* ]] || bind_address="[$bind_address]"
  if [[ "$ssl_mode" == "letsencrypt" ]]; then
    health_url="https://${app_host}:${port}/up"
    # Keep certificate and SNI checks for the public hostname while connecting
    # directly to the published address. First issuance may need a TLS handshake.
    curl_options=(--connect-timeout 30 --max-time 30 --noproxy '*' --globoff -fsS --head --output /dev/null --write-out '%{http_code}')
    curl_options+=(--resolve "${app_host}:${port}:${bind_address}")
  else
    health_url="http://${bind_address}:${port}/up"
    curl_options+=(-H "Host: ${app_host}")
  fi

  while (( SECONDS < deadline )); do
    if response_code="$(curl "${curl_options[@]}" "$health_url")" && [[ "$response_code" == "200" ]]; then
      printf "%s returned HTTP 200 for Host: %s\n" "$health_url" "$app_host"
      return 0
    fi

    sleep 1
  done

  compose logs --tail=120 web >&2 || true
  fail "web did not return HTTP 200 from ${health_url} within ${timeout_seconds}s"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'USAGE'
Usage:
  ./scripts/deploy

Builds the production image, starts PostgreSQL, runs db:prepare, starts the web
container, and verifies the published web endpoint (HTTPS for letsencrypt mode).
Activity sampling runs inside the app. A legacy sampler container is retired
only after the replacement web service passes both health checks.

Compose reads PLEX_ADMIN_BIND and PLEX_ADMIN_PORT from .env when present.
Shell overrides also work: PLEX_ADMIN_PORT=3011 ./scripts/deploy.
Health checks use the running container's published address and port.
USAGE
  exit 0
fi

require_file .env.production
require_file .env.postgres
for command in docker git curl; do
  command -v "$command" >/dev/null || fail "required command not found: $command"
done

# mkdir is atomic and works with the stock macOS and Linux toolchains.
mkdir -p tmp
mkdir tmp/deploy.lock 2>/dev/null || fail "another deploy holds tmp/deploy.lock; remove it only after confirming that deploy has stopped"
trap 'rmdir "$ROOT/tmp/deploy.lock"' EXIT

update_code
set_app_revision
compose config --quiet

legacy_sampler_present=false
existing_services="$(compose --profile sampling ps --all --services)"
if [[ $'\n'"$existing_services"$'\n' == *$'\nnow_playing_sampler\n'* ]]; then
  legacy_sampler_present=true
fi

log "Building app image"
compose build web

log "Starting PostgreSQL"
compose up -d db
wait_for_healthy db 90

log "Preparing databases"
compose run --rm web ./bin/rails db:prepare

log "Starting app services"
compose up -d --no-deps web daily_refresh
wait_for_healthy web 120
wait_for_http 30

if [[ "$legacy_sampler_present" == true ]]; then
  log "Retiring legacy sampler; activity sampling now runs inside the app"
  compose --profile sampling stop now_playing_sampler
  compose --profile sampling rm -f now_playing_sampler
fi

log "Deploy complete"
compose ps
