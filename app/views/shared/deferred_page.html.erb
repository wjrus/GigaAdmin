<% content_for :title, "#{@deferred_page_title} · GigaAdmin" %>
<% fallback_path = "#{request.path}?#{request.query_parameters.merge('sync' => '1').to_query}" %>

<%= turbo_frame_tag "page-content", src: request.fullpath, target: "_top", disabled: true, class: "block", aria: { busy: true },
  data: {
    controller: "deferred-page",
    deferred_page_sign_in_url_value: sign_in_path,
    deferred_page_setup_url_value: setup_path,
    action: "turbo:before-fetch-request->deferred-page#loading turbo:before-fetch-response->deferred-page#response turbo:fetch-request-error->deferred-page#failed turbo:frame-missing->deferred-page#missing turbo:frame-load->deferred-page#loaded"
  } do %>
  <div class="mx-auto flex w-full max-w-[100rem] flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
    <header class="flex min-h-16 flex-col gap-4 border-b border-zinc-800 pb-5 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-3xl font-semibold tracking-normal text-white"><%= @deferred_page_title %></h1>
      <%= render "shared/page_nav" %>
    </header>

    <section class="rounded-lg border border-zinc-800 bg-zinc-950 p-5" aria-label="Page loading">
      <p data-deferred-page-target="loading" role="status" class="text-sm text-zinc-300">Loading <%= @deferred_page_title.downcase %>…</p>
      <div data-deferred-page-target="error" role="alert" hidden>
        <p class="text-sm text-amber-200">This page couldn't load. Retry, or open it without background loading.</p>
        <button type="button" data-action="deferred-page#retry" class="mt-3 rounded-md border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 focus:outline-none focus:ring-2 focus:ring-cyan-200">Try again</button>
      </div>
      <p class="mt-3 text-sm"><%= link_to "Open without background loading", fallback_path, data: { turbo: false }, class: "text-cyan-300 underline" %></p>
      <noscript><p class="mt-2 text-sm text-zinc-400">JavaScript is disabled. Use the link above to open this page.</p></noscript>
    </section>
  </div>
<% end %>
