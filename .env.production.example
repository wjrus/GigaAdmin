RAILS_ENV=production
RAILS_LOG_LEVEL=info
SECRET_KEY_BASE=generated-by-scripts-setup
TZ=Etc/UTC

# Private localhost HTTP for initial setup; see docs/deploy.md for public HTTPS.
PLEX_HOST=localhost
PLEX_HOSTS=localhost
PLEX_ASSUME_SSL=false
PLEX_FORCE_SSL=false

PLEX_DATABASE_PASSWORD=generated-by-scripts-setup

# auto uses local email/password accounts unless BOTH Google credentials are set.
GIGAADMIN_AUTH_MODE=auto
# Optional local super-admin emails; required allowlist for Google sign-in.
# The first local account is always a super administrator.
ADMIN_USERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PLEX_TOKEN=
PLEX_MACHINE_IDENTIFIER=
PLEX_API_BASE_URL=https://plex.tv
# Address reachable from inside Docker, such as http://plex-server.example.com:32400.
PLEX_SERVER_BASE_URL=
PLEX_HISTORY_PAGE_SIZE=1000
PLEX_HISTORY_MAX_PAGES=all
PLEX_HISTORY_DAYS=730
PLEX_HISTORY_RETRIES=8
PLEX_DAILY_REFRESH_AT=04:15
PLEX_DAILY_REFRESH_DAYS=1
PLEX_CLIENT_IDENTIFIER=gigaadmin-production
PLEX_CLIENT_NAME=GigaAdmin
PLEX_NOW_PLAYING_SAMPLE_INTERVAL=60
PLEX_NOW_PLAYING_RETENTION_DAYS=90
